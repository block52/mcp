# --- Core (agentd) ---
LISTEN=:50051
CHAIN_ID=pokerchain
REST_ENDPOINT=http://localhost:1317
RPC_ENDPOINT=http://localhost:26657
WS_ENDPOINT=ws://localhost:8585

# Agent identity (one of).
MNEMONIC=
PRIVATE_KEY=

# Whose money the key controls: "own" (default) or "delegated" (full key
# hand-off from a human — FULL control, NO spend cap; see SECURITY.md).
OWNER=own

# --- MCP adapter ---
CORE_ADDR=http://localhost:50051

# --- Moltbook (Phase 6) ---
# Obtain via `go run ./core/cmd/moltbook-register` then the human email + X
# verification steps it prints. Empty = posting disabled.
MOLTBOOK_API_KEY=
# Optional base-URL override (staging/testing); empty -> https://www.moltbook.com
MOLTBOOK_BASE_URL=
